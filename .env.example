# ============================================
# PodFlow AI - Environment Variables
# ============================================
# Copy this file to .env and fill in your API keys:
#   cp .env.example .env
#
# Get your API keys from:
#   Groq (Qwen model): https://console.groq.com
#   Agnes AI:           https://platform.agnes-ai.com
# ============================================

# Groq API Key (for Research Agent - Qwen model)
GROQ_API_KEY=gsk_your_groq_key_here

# Agnes AI API Key (for Script Writer Agent)
AGNES_API_KEY=sk_your_agnes_key_here
